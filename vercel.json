{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*\\.js)",
      "headers": { "Content-Type": "application/javascript; charset=utf-8" },
      "continue": true
    },
    {
      "src": "/(.*\\.css)",
      "headers": { "Content-Type": "text/css; charset=utf-8" },
      "continue": true
    },
    {
      "src": "/(.*\\.json)",
      "headers": { "Content-Type": "application/json; charset=utf-8" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
